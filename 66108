}
async function syncPush(manual) {
  if (syncBusy) return;
  if (!syncReady()) { if (manual) alert('اضبط رابط الاستضافة والمفتاح أولاً'); return; }
  if (!navigator.onLine) { if (manual) alert('لا يوجد اتصال بالإنترنت'); return; }
  syncBusy = true; setSyncStatus('جارٍ الرفع…');
  try {
    await whenSaved(); unsynced = false;
    const diff = Object.keys(PHOTOS).filter(id => SYNCMETA[id] !== PHOTOS[id].length);
    await syncCall('put', backupObject(false));
    let batch = {}, sent = [], size = 0;
    const flushB = async () => { if (!sent.length) return; await syncCall('putphotos', batch); sent.forEach(id => { SYNCMETA[id] = PHOTOS[id].length; }); batch = {}; sent = []; size = 0; };
    for (const id of diff) { batch[id] = PHOTOS[id]; sent.push(id); size += PHOTOS[id].length; if (size > 900000) await flushB(); }
    await flushB(); await store.set('syncmeta', SYNCMETA);
    DB.settings.last_sync = Date.now(); DB.settings.sync_err = '';
    if (manual) { logAct('رفع نسخة إلى الاستضافة', diff.length + ' صورة جديدة'); flash('ok', 'تم رفع النسخة إلى الاستضافة'); }
    save(true); nextTry = 0;
  } catch (e) {
    unsynced = true; DB.settings.sync_err = e.message; save(true); nextTry = Date.now() + 600000;
    if (manual) alert(e.message);
  } finally { syncBusy = false; if (manual) render(); else setSyncStatus(DB.settings.last_sync ? 'آخر رفع: ' + dtf(DB.settings.last_sync) : ''); }
}
