const setSyncStatus = t => { const el = $('#syncst'); if (el) el.textContent = t; };
async function syncCall(action, data) {
  const s = DB.settings; if (!syncReady()) throw new Error('اضبط رابط الاستضافة والمفتاح أولاً');
  const url = s.sync_url + (s.sync_url.indexOf('?') > -1 ? '&' : '?') + 'i=1';   // يتجاوز حماية InfinityFree للطلبات الآلية
  const ctl = new AbortController(), t = setTimeout(() => ctl.abort(), 90000); let res;
  try { res = await fetch(url, {method: 'POST', headers: {'Content-Type': 'text/plain'}, body: JSON.stringify({k: s.sync_key, a: action, d: data}), signal: ctl.signal, cache: 'no-store'}); }
  catch (e) { throw new Error(navigator.onLine ? 'تعذّر الوصول إلى الاستضافة. تحقق من الرابط وأن الموقع يعمل.' : 'لا يوجد اتصال بالإنترنت'); }
  finally { clearTimeout(t); }
  const txt = await res.text(); let j;
  try { j = JSON.parse(txt); } catch (e) { throw new Error('ردّ الاستضافة غير صحيح (قد تمنعه حماية InfinityFree أو الرابط خاطئ). تأكد من الرابط ثم أعد المحاولة.'); }
  if (!j.ok) throw new Error(j.message || 'فشلت العملية');
