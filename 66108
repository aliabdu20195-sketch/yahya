.list a.item{display:flex;justify-content:space-between;align-items:center;padding:14px;border:1px solid var(--line);background:var(--card);border-radius:12px;margin-bottom:8px;text-decoration:none;color:var(--ink);font-weight:600}
.photorow{display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin:6px 0}
