main{max-width:900px;margin:auto;padding:14px 14px calc(30px + env(safe-area-inset-bottom))}
.tabs{background:var(--card);border-bottom:1px solid var(--line);display:flex;box-shadow:0 2px 6px rgba(0,0,0,.08)}
