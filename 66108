  if (r.name === 'bikes') bindBike();
  if (r.name === 'customer') PEND = {mode: 'keep', data: null};
  const pf = $('#pf'); if (pf) pf.onchange = async () => { const f = pf.files[0]; if (!f) return; try { const d = await readPhoto(f); PEND = {mode: 'set', data: d}; $('#pprev').innerHTML = '<img class="avatar lg" src="' + d + '" alt="">'; } catch (e) { alert('تعذر قراءة الصورة'); } };
  const rf = $('#rf'); if (rf) rf.onchange = () => { if (rf.files[0]) restoreBackup(rf.files[0]); };
  const ib = $('#installbox'); if (ib && window.__installEvt) ib.innerHTML = '<br><button class="btn sec" data-act="install">تثبيت التطبيق الآن</button>';
  tick();
}

/* ====================== العداد الحي ====================== */
function shortDur(sec) { sec = Math.floor(sec); const d = Math.floor(sec / 86400), h = Math.floor(sec % 86400 / 3600), m = Math.floor(sec % 3600 / 60); return d ? d + ' يوم ' + h + ' س' : h ? h + ' س ' + m + ' د' : m + ' د'; }
function tick() {
  const now = Date.now();
  document.querySelectorAll('.rt').forEach(el => {
    const r = rentalOf(+el.dataset.id); if (!r || r.status !== 'active') return;
    el.querySelector('.clock').textContent = dur((now - r.start) / 1000); el.querySelector('.live-amt').textContent = fmt(calcRental(r, now).total);
    const rem = el.querySelector('.rem');
    if (r.planned_end) { const left = (r.planned_end - now) / 1000; if (left >= 0) { rem.textContent = 'متبقي ' + shortDur(left); el.classList.remove('late'); } else { rem.textContent = 'متأخر ' + shortDur(-left); el.classList.add('late'); } }
    else rem.textContent = 'مدة مفتوحة';
  });
}
setInterval(tick, 1000);

/* ====================== الأحداث ====================== */
const FORMS = {
  rent: f => startRental(f),
  end: (f, el) => finishRental(+el.dataset.id, f),
  paydebt: (f, el) => payDebt(+el.dataset.id, f.amount),
  custpay: (f, el) => payCustomerDebt(+el.dataset.id, f.amount),
  filter: (f, el) => { const p = new URLSearchParams(); Object.entries(f).forEach(([k, v]) => { if (v) p.set(k, v); }); go(el.dataset.page + (p.toString() ? '?' + p : '')); },
  bike: f => saveBike(f),
  sell: (f, el) => sellBike(+el.dataset.id, f),
  maint: (f, el) => saveMaint(f, el),
  addpart: (f, el) => addPart(+el.dataset.id, f),
  customer: f => {
    const name = (f.name || '').trim(); if (!name) return fail('أدخل اسم العميل');
    const v = {name, phone: (f.phone || '').trim(), address: (f.address || '').trim(), guarantor: (f.guarantor || '').trim(), guarantor_phone: (f.guarantor_phone || '').trim(), notes: (f.notes || '').trim()};
    let id = +f.id; if (id) Object.assign(custOf(id), v); else { id = nid('cust'); DB.customers.push({id, ...v, created: Date.now()}); }
    applyPhoto(id); logAct(+f.id ? 'تعديل عميل' : 'إضافة عميل', name); save(); flash('ok', 'تم حفظ بيانات العميل'); go('customers');
  },
  expense: f => { const a = numIn(f.amount), cat = (f.cat || '').trim(); if (!cat || a <= 0) return fail('أدخل نوع المصروف والمبلغ'); if (!needAdmin()) return; cashAdd('expense', a, 0, cat, (f.note || '').trim(), dateToTs(f.date)); logAct('تسجيل مصروف', cat + ' — ' + fmt(a)); save(); flash('ok', 'تم تسجيل المصروف'); render(); },
  owner: f => { const a = numIn(f.amount); if (a <= 0) return fail('أدخل مبلغاً صحيحاً'); if (!needAdmin()) return; cashAdd(f.kind === 'owner_out' ? 'owner_out' : 'owner_in', a, 0, '', (f.note || '').trim()); logAct(f.kind === 'owner_out' ? 'سحب المالك' : 'إيداع المالك', fmt(a)); save(); flash('ok', 'تم التسجيل'); render(); },
  settings: f => {
    if (!needAdmin()) return;
    const s = DB.settings; s.contract_terms = (f.contract_terms || '').trim() || TERMS; s.shop_name = (f.shop_name || '').trim() || DEF.shop_name; s.shop_phone = (f.shop_phone || '').trim(); s.footer = (f.footer || '').trim();
    s.default_rate = numIn(f.default_rate) || 300; s.opening_cash = numIn(f.opening_cash); s.grace = Math.max(0, numIn(f.grace)); s.late_pct = Math.max(0, numIn(f.late_pct));
    s.round_to = Math.max(1, numIn(f.round_to) || 1); s.early_mode = f.early_mode === 'agreed' ? 'agreed' : 'actual'; s.auto_delete = !!f.auto_delete;
    logAct('تعديل الإعدادات', ''); save(); flash('ok', 'تم حفظ الإعدادات'); go('settings');
  },
  sync: f => {
    if (!needAdmin()) return;
    const u = (f.sync_url || '').trim();
    if (u && !/^https:\/\//i.test(u) && !/^http:\/\/(localhost|127\.0\.0\.1)/i.test(u)) return fail('الرابط يجب أن يبدأ بـ https://');
    DB.settings.sync_url = u; DB.settings.sync_key = (f.sync_key || '').trim(); DB.settings.sync_auto = !!f.sync_auto; DB.settings.sync_err = ''; nextTry = 0;
    logAct('ضبط النسخ على الاستضافة', u); save(); flash('ok', 'تم حفظ الإعداد' + (u && DB.settings.sync_key ? ' — جرّب "اختبار الاتصال"' : '')); render(); setTimeout(autoSync, 800);
  },
  type: f => saveType(f),
  user: f => saveUser(f),
  block: (f, el) => { const c = custOf(+el.dataset.id); if (!c) return; c.blocked = 1; c.block_reason = (f.reason || '').trim(); logAct('حظر عميل', c.name + (c.block_reason ? ' — ' + c.block_reason : '')); save(); flash('ok', 'تم حظر العميل'); render(); },
  unlock: async f => {
    if (Date.now() < lockUntil) return alert('محاولات كثيرة خاطئة، انتظر نصف دقيقة.');
    const u = DB.users.find(x => x.id === +f.uid && x.active);
    if (u && (await hashPin(String(f.pin || '').trim(), u)) === u.pin) { fails = 0; ssSet('uid', u.id); logAct('تسجيل دخول', ''); save(); render(); }
    else { if (++fails >= 5) { fails = 0; lockUntil = Date.now() + 30000; } alert('الاسم أو الرقم السري غير صحيح'); }
  },
};
document.addEventListener('submit', e => { const f = e.target.closest('form[data-form]'); if (!f) return; e.preventDefault(); FORMS[f.dataset.form](Object.fromEntries(new FormData(f)), f); });

const ACTS = {
  print: () => window.print(),
  sharetext: async el => { const t = receiptText(rentalOf(+el.dataset.id)); if (navigator.share) { try { await navigator.share({text: t}); } catch (e) {} } else { try { await navigator.clipboard.writeText(t); alert('تم نسخ نص الإيصال'); } catch (e) { alert(t); } } },
  cancel: el => { if (confirm('إلغاء هذا الإيجار نهائياً؟')) cancelRental(+el.dataset.id); },
  delbike: el => deleteBike(+el.dataset.id),
  undosale: el => { if (confirm('إلغاء بيع الدراجة وسحب المبلغ من الصندوق؟')) undoSale(+el.dataset.id); },
  delcust: el => { if (!needAdmin()) return; const id = +el.dataset.id; if (DB.rentals.some(r => r.customer_id === id && (r.status === 'active' || balance(r) > 0))) return fail('لا يمكن حذف عميل عنده إيجار جارٍ أو مبلغ متبقٍ عليه'); if (!confirm('حذف العميل؟')) return; logAct('حذف عميل', (custOf(id) || {}).name); DB.customers = DB.customers.filter(c => c.id !== id); delete PHOTOS[id]; savePhotos(); save(); flash('ok', 'تم حذف العميل'); go('customers'); },
  rmphoto: () => { PEND = {mode: 'remove', data: null}; $('#pprev').innerHTML = '<span class="avatar lg">؟</span>'; },
  purge: () => { if (!needAdmin()) return; if (confirm('سيتم حذف كل عميل أكمل إيجاره ولا عليه متبقٍ. هل نزّلت نسخة احتياطية؟ متابعة؟')) { purgeCustomers(); render(); } },
  addrow: () => addPartRow(),
  shareinv: async el => { const m = DB.maint.find(x => x.id === +el.dataset.id); if (!m) return; const t = invoiceText(m); if (navigator.share) { try { await navigator.share({text: t}); } catch (e) {} } else { try { await navigator.clipboard.writeText(t); alert('تم نسخ نص الفاتورة'); } catch (e) { alert(t); } } },
  syncnow: () => syncPush(true),
  syncpull: () => syncPull(),
  syncping: () => syncPing(),
  logout: () => { logAct('تسجيل خروج', ''); save(); ssSet('uid', null); location.hash = '#/dashboard'; render(); },
  unblock: el => { if (!needAdmin()) return; const c = custOf(+el.dataset.id); if (!c) return; c.blocked = 0; c.block_reason = ''; logAct('رفع حظر عميل', c.name); save(); flash('ok', 'تم رفع الحظر'); render(); },
  typedel: el => deleteType(+el.dataset.id),
  userpin: async el => {
    if (!needAdmin()) return; const u = DB.users.find(x => x.id === +el.dataset.id); if (!u) return;
    const p = prompt('الرقم السري الجديد لـ ' + u.name + ' (4 أرقام فأكثر)'); if (p === null) return;
    if (p.trim().length < 4) return alert('الرقم السري 4 أرقام على الأقل');
    u.legacy = false; u.pin = await hashPin(p.trim(), u); logAct('تغيير رقم سري', u.name); save(); flash('ok', 'تم تغيير الرقم السري'); render();
  },
  usertoggle: el => { if (!needAdmin()) return; const u = DB.users.find(x => x.id === +el.dataset.id); if (!u || lastAdminGuard(u)) return; u.active = !u.active; logAct(u.active ? 'تفعيل مستخدم' : 'إيقاف مستخدم', u.name); save(); flash('ok', 'تم التحديث'); render(); },
  userrole: el => { if (!needAdmin()) return; const u = DB.users.find(x => x.id === +el.dataset.id); if (!u) return; if (u.role === 'admin' && lastAdminGuard(u)) return; u.role = u.role === 'admin' ? 'staff' : 'admin'; logAct('تغيير صلاحية', u.name + ' → ' + (u.role === 'admin' ? 'مدير' : 'موظف')); save(); flash('ok', 'تم التحديث'); render(); },
  userdel: el => { if (!needAdmin()) return; const u = DB.users.find(x => x.id === +el.dataset.id); if (!u || lastAdminGuard(u) || !confirm('حذف المستخدم ' + u.name + '؟')) return; const self = curUser() && curUser().id === u.id; logAct('حذف مستخدم', u.name); DB.users = DB.users.filter(x => x.id !== u.id); save(); if (self) ssSet('uid', null); flash('ok', 'تم حذف المستخدم'); render(); },
  mdone: el => completeMaint(+el.dataset.id),
  mdel: el => deleteMaint(+el.dataset.id),
  delcash: el => { if (!needAdmin() || !confirm('حذف هذه الحركة؟')) return; logAct('حذف حركة صندوق', '#' + el.dataset.id); DB.cash = DB.cash.filter(e => e.id !== +el.dataset.id); save(); render(); },
  csvled: () => dlCsv('cash_ledger.csv', [['date', 'type', 'amount', 'category', 'note', 'ref']].concat(DB.cash.map(e => [dtf(e.at), CASH[e.type][0], e.amount, e.cat, e.note, e.ref]))),
  csvrent: el => { const from = el.dataset.from, to = el.dataset.to, rows = [['id', 'bike', 'customer', 'plan', 'price', 'start', 'arrival', 'delay_min', 'delay_cost', 'total', 'discount', 'paid', 'balance']];
    DB.rentals.filter(r => r.status === 'finished' && r.arrival && dayKey(r.arrival) >= from && dayKey(r.arrival) <= to).forEach(r => rows.push([r.id, bikeLabel(bikeOf(r.bike_id)), cname(r), planLabel(r), r.price, dtf(r.start), dtf(r.arrival), r.delay_min, r.delay_cost, r.total, r.discount, r.paid, balance(r)])); dlCsv('rentals_' + from + '_' + to + '.csv', rows); },
  dl: () => downloadBackup(),
  share: () => shareBackup(),
  install: async () => { const e = window.__installEvt; if (e) { e.prompt(); await e.userChoice; window.__installEvt = null; render(); } },
  wipe: async () => { if (!needAdmin()) return; if (prompt('اكتب كلمة "حذف" لتأكيد مسح كل البيانات نهائياً') === 'حذف') { DB = emptyDB(); PHOTOS = {}; ssSet('uid', null); await savePhotos(); save(); flash('ok', 'تم مسح كل البيانات'); go('dashboard'); } },
};
function dlCsv(name, rows) {
  const q = v => '"' + String(v ?? '').replace(/"/g, '""') + '"', blob = new Blob(['﻿' + rows.map(r => r.map(q).join(',')).join('\n')], {type: 'text/csv;charset=utf-8'}), a = document.createElement('a');
  a.href = URL.createObjectURL(blob); a.download = name; document.body.appendChild(a); a.click(); a.remove();
}
document.addEventListener('click', e => { const el = e.target.closest('[data-act]'); if (el && ACTS[el.dataset.act]) { e.preventDefault(); ACTS[el.dataset.act](el); } });

window.addEventListener('hashchange', render);
window.addEventListener('online', render); window.addEventListener('offline', render);
window.addEventListener('beforeinstallprompt', e => { e.preventDefault(); window.__installEvt = e; });
if ('serviceWorker' in navigator && /^https?:/.test(location.protocol)) navigator.serviceWorker.register('sw.js').catch(() => {});

/* ====================== الإقلاع ====================== */
(async function boot() {
  await store.init();
  let raw = await store.get('db'), d = null;
  if (raw) { try { d = JSON.parse(raw); } catch (e) { d = null; } }
  if (!d) { const p = await store.get('db_prev'); if (p) { try { d = JSON.parse(p); } catch (e) {} } }
  if (!d) { try { const old = localStorage.getItem('bike_rental_v1'); if (old) d = JSON.parse(old); } catch (e) {} }   // ترحيل من النسخة الأولى
  DB = d ? normalize(d) : emptyDB(); LAST = JSON.stringify(DB);
  PHOTOS = (await store.get('photos')) || {}; SYNCMETA = (await store.get('syncmeta')) || {}; unsynced = !DB.settings.last_sync; setTimeout(autoSync, 5000);
  if (navigator.storage && navigator.storage.persist) navigator.storage.persist();
  READY = true; render();
})();
</script>
