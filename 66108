.filters{display:grid;gap:8px;grid-template-columns:1fr 1fr;margin-bottom:12px}
.kv{display:flex;justify-content:space-between;gap:10px;padding:7px 0;border-bottom:1px dashed var(--line)}.kv:last-child{border:0}.kv b{font-variant-numeric:tabular-nums}
.big{font-size:1.5rem;font-weight:700}
.empty{text-align:center;color:var(--muted);padding:22px 10px}
.acts{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.receipt{max-width:460px;margin:auto}
