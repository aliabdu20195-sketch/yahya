<body>
<div id="app"><div class="lock card"><h1>جارٍ التحميل…</h1></div></div>
<script>
'use strict';
/* ====================== التخزين (IndexedDB مع بديل localStorage) ====================== */
const store = (() => {
  let db = null, mode = 'idb';
  const LSP = 'bikerent2_';
  const open = () => new Promise(res => {
    try {
      const rq = indexedDB.open('bike_rental', 1);
      rq.onupgradeneeded = () => rq.result.createObjectStore('kv');
      rq.onsuccess = () => { db = rq.result; res(true); };
      rq.onerror = rq.onblocked = () => res(false);
    } catch (e) { res(false); }
  });
  return {
    async init() { if (!(await open())) mode = 'ls'; return mode; },
    get(k) {
      if (mode === 'ls') { try { const v = localStorage.getItem(LSP + k); return Promise.resolve(v == null ? null : JSON.parse(v)); } catch (e) { return Promise.resolve(null); } }
      return new Promise(res => { try { const rq = db.transaction('kv').objectStore('kv').get(k); rq.onsuccess = () => res(rq.result === undefined ? null : rq.result); rq.onerror = () => res(null); } catch (e) { res(null); } });
    },
    set(k, v) {
      if (mode === 'ls') { try { localStorage.setItem(LSP + k, JSON.stringify(v)); return Promise.resolve(true); } catch (e) { return Promise.resolve(false); } }
      return new Promise(res => { try { const tx = db.transaction('kv', 'readwrite'); tx.objectStore('kv').put(v, k); tx.oncomplete = () => res(true); tx.onerror = tx.onabort = () => res(false); } catch (e) { res(false); } });
    },
  };
})();

/* ====================== النموذج والبيانات ====================== */
const PLANS = {
  q15: {label: 'ربع ساعة', unit: 15, qlabel: 'عدد أرباع الساعة (اختياري)'},
  q30: {label: 'نصف ساعة', unit: 30, qlabel: 'عدد أنصاف الساعة (اختياري)'},
  h60: {label: 'ساعة', unit: 60, qlabel: 'عدد الساعات (اختياري)'},
  day: {label: 'يوم', unit: 1440, qlabel: 'عدد الأيام (اختياري)'},
  week: {label: 'أسبوع', unit: 10080, qlabel: 'عدد الأسابيع (اختياري)'},
  month: {label: 'اشتراك شهري', unit: 0, qlabel: 'عدد الأشهر (اتركه فارغاً لمدة مفتوحة)'},
  flat: {label: 'سعر مقطوع', unit: 1440, qlabel: 'عدد الأيام المتفق عليها'},
};
const TERMS = "1) يقرّ المستأجر باستلام الدراجة سليمة وبالحالة الموضحة، ويلتزم بإعادتها بنفس الحالة.\n2) المستأجر مسؤول عن أي ضرر أو فقدان أو مخالفات مرورية أثناء مدة الإيجار.\n3) يُمنع تأجير الدراجة لشخص آخر أو استخدامها خارج النظام العام.\n4) التأخير عن موعد الإرجاع يُحتسب بسعر الإيجار المتفق عليه.\n5) يُسترد التأمين عند تسليم الدراجة سليمة، ويُخصم منه قيمة أي ضرر.";
const DEF = {shop_name: 'محلات تأجير الدراجات', shop_phone: '', footer: 'شكراً لزيارتكم', default_rate: 300, grace: 0, round_to: 1,
             late_pct: 0, early_mode: 'actual', auto_delete: false, opening_cash: 0, pin: '', last_backup: 0, contract_terms: TERMS, sync_url: '', sync_key: '', sync_auto: true, last_sync: 0, sync_err: ''};
const emptyDB = () => ({v: 3, settings: {...DEF}, bikes: [], customers: [], rentals: [], cash: [], maint: [], types: [], users: [], log: [],
                        seq: {bike: 0, cust: 0, rent: 0, cash: 0, maint: 0, type: 0, user: 0, log: 0}});
function normalize(d) {
  const b = emptyDB();
  b.settings = {...DEF, ...(d.settings || {})};
  if (b.settings.early_mode !== 'agreed') b.settings.early_mode = 'actual';
  b.bikes = (d.bikes || []).map(x => ({id: x.id, name: x.name || x.model || '', type_id: +x.type_id || 0, size: x.size || '', serial: x.serial || x.plate || '',
    buy_price: +x.buy_price || 0, sell_price: +x.sell_price || 0, rate: +x.rate || 0, rate15: +x.rate15 || 0, rate30: +x.rate30 || 0, rate_day: +x.rate_day || 0, rate_week: +x.rate_week || 0, month_price: +x.month_price || 0,
    status: ['available', 'maintenance', 'sold'].includes(x.status) ? x.status : 'available', buy_date: x.buy_date || 0,
    sold_at: x.sold_at || 0, sold_price: +x.sold_price || 0, sold_to: x.sold_to || '', notes: x.notes || ''}));
  b.customers = (d.customers || []).map(c => ({id: c.id, name: c.name || '', phone: c.phone || '', address: c.address || '',
    guarantor: c.guarantor || '', guarantor_phone: c.guarantor_phone || '', blocked: c.blocked ? 1 : 0, block_reason: c.block_reason || '', notes: ((c.idno ? 'هوية: ' + c.idno + ' ' : '') + (c.notes || '')).trim(), created: c.created || 0}));
  b.rentals = (d.rentals || []).map(r => ({id: r.id, bike_id: r.bike_id, customer_id: r.customer_id,
    plan: PLANS[r.plan] ? r.plan : 'h60', unit_min: r.unit_min !== undefined ? r.unit_min : 60,
    price: +(r.price !== undefined ? r.price : r.rate) || 0, qty: +(r.qty !== undefined ? r.qty : Math.ceil((r.expected_min || 0) / 60)) || 0,
    start: r.start, planned_end: r.planned_end !== undefined ? r.planned_end : (r.expected_min ? r.start + r.expected_min * 60000 : 0),
    arrival: r.arrival !== undefined ? r.arrival : (r.end || null), delay_min: +r.delay_min || 0, delay_cost: +r.delay_cost || 0, base: +r.base || 0,
    deposit: +r.deposit || 0, deposit_note: r.deposit_note || '', discount: +r.discount || 0, total: +r.total || 0, paid: +r.paid || 0,
    refund: +r.refund || 0, status: r.status, notes: r.notes || '', by: r.by || ''}));
  b.cash = Array.isArray(d.cash) ? d.cash : (d.payments || []).map((p, i) => ({id: i + 1, at: p.at, type: p.kind === 'debt' ? 'debt' : 'rental_pay', amount: +p.amount || 0, ref: p.rental_id, cat: '', note: ''}));
  b.maint = (Array.isArray(d.maint) ? d.maint : []).map(m => ({...m, owner: m.owner || '', by: m.by || ''}));
  b.cash.forEach(e => { if (e.type === 'maint') { const m = b.maint.find(x => x.id === e.ref); if (m && m.owner) { e.type = 'repair_rev'; e.amount = Math.abs(e.amount); } } });
  b.types = (d.types || []).map(t => ({id: t.id, name: t.name || '', rate: +t.rate || 0, rate15: +t.rate15 || 0, rate30: +t.rate30 || 0, rate_day: +t.rate_day || 0, rate_week: +t.rate_week || 0, month_price: +t.month_price || 0, notes: t.notes || ''}));
  b.users = (d.users || []).map(u => ({id: u.id, name: u.name || '', role: u.role === 'staff' ? 'staff' : 'admin', pin: u.pin || '', legacy: !!u.legacy, active: u.active !== false}));
  b.log = Array.isArray(d.log) ? d.log.slice(-1000) : [];
  b.seq = {...b.seq, ...(d.seq || {})};
  const mx = a => Math.max(0, ...a.map(x => x.id || 0));
  b.seq.bike = Math.max(b.seq.bike, mx(b.bikes)); b.seq.cust = Math.max(b.seq.cust, mx(b.customers));
  b.seq.rent = Math.max(b.seq.rent, mx(b.rentals)); b.seq.cash = Math.max(b.seq.cash, mx(b.cash)); b.seq.maint = Math.max(b.seq.maint, mx(b.maint));
  b.seq.type = Math.max(b.seq.type, mx(b.types)); b.seq.user = Math.max(b.seq.user, mx(b.users)); b.seq.log = Math.max(b.seq.log, mx(b.log));
  if (!b.users.length && b.settings.pin) { b.users.push({id: ++b.seq.user, name: 'المدير', role: 'admin', pin: b.settings.pin, legacy: true, active: true}); }   // ترحيل القفل القديم
  b.settings.pin = '';
  return b;
}
let DB = emptyDB(), PHOTOS = {}, READY = false;
let saving = false, dirty = false, LAST = '', warned = false;
let unsynced = false;
function save(quiet) { if (quiet !== true) unsynced = true; dirty = true; if (!saving) flush(); }
async function flush() {
  saving = true;
  while (dirty) {
    dirty = false;
    const js = JSON.stringify(DB);
    const ok = await store.set('db', js);
    if (ok) { if (LAST) await store.set('db_prev', LAST); LAST = js; }
    else if (!warned) { warned = true; alert('تعذر حفظ البيانات! قد تكون المساحة ممتلئة أو التخزين معطّل. نزّل نسخة احتياطية الآن من الإعدادات.'); }
  }
  saving = false;
}
const whenSaved = () => new Promise(r => { const t = () => (saving || dirty) ? setTimeout(t, 15) : r(true); t(); });
async function savePhotos() { unsynced = true; if (!(await store.set('photos', PHOTOS)) && !warned) { warned = true; alert('تعذر حفظ الصور. المساحة قد تكون ممتلئة.'); } }
const nid = k => ++DB.seq[k];
const TMP = {};
let FLASH = null;
const flash = (t, m) => { FLASH = [t, m]; };

/* ====================== أدوات ====================== */
const $ = s => document.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c]));
const AR = '٠١٢٣٤٥٦٧٨٩';
const numIn = s => { const t = String(s ?? '').replace(/[٠-٩]/g, d => AR.indexOf(d)).replace(/[٫،,]/g, '.'); const n = parseFloat(t.replace(/[^0-9.]/g, '')); return isNaN(n) ? 0 : n; };
const fmt = n => { n = +n || 0; return (Math.abs(n - Math.round(n)) < 0.005 ? Math.round(n) : Math.round(n * 100) / 100).toLocaleString('en-US'); };
const pad = n => String(n).padStart(2, '0');
const dtf = ts => { if (!ts) return '—'; const d = new Date(ts); return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()); };
const dayKey = ts => { const d = new Date(ts); return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); };
const dtLocal = ts => dayKey(ts) + 'T' + pad(new Date(ts).getHours()) + ':' + pad(new Date(ts).getMinutes());
const parseLocal = v => v ? new Date(v).getTime() : NaN;
const dateToTs = v => (!v || v === dayKey(Date.now())) ? Date.now() : new Date(v + 'T12:00:00').getTime();
const dur = sec => { sec = Math.max(0, Math.floor(sec)); const d = Math.floor(sec / 86400), r = sec % 86400; return (d ? d + 'ي ' : '') + pad(Math.floor(r / 3600)) + ':' + pad(Math.floor(r % 3600 / 60)) + ':' + pad(r % 60); };
const durMin = m => { m = Math.max(0, Math.round(m)); const d = Math.floor(m / 1440), h = Math.floor(m % 1440 / 60), mm = m % 60; return (d ? d + ' يوم ' : '') + (h ? h + ' ساعة ' : '') + (mm || (!d && !h) ? mm + ' دقيقة' : ''); };
const sum = (a, f) => a.reduce((x, y) => x + (+f(y) || 0), 0);
const CUR = 'ريال';
const addMonths = (ts, n) => { const d = new Date(ts); d.setMonth(d.getMonth() + n); return d.getTime(); };
const fail = m => { alert(m); };

const bikeOf = id => DB.bikes.find(b => b.id === id);
const custOf = id => DB.customers.find(c => c.id === id);
const rentalOf = id => DB.rentals.find(r => r.id === id);
const isRented = id => DB.rentals.some(r => r.status === 'active' && r.bike_id === id);
const activeRentals = () => DB.rentals.filter(r => r.status === 'active').sort((a, b) => a.start - b.start);
const cname = r => (TMP[r.id] && TMP[r.id].name) || (custOf(r.customer_id) && custOf(r.customer_id).name) || 'عميل محذوف';
const balance = r => r.status !== 'finished' ? 0 : Math.max(0, r.total - Math.min(r.deposit, r.total) - r.paid);
const bikeLabel = b => b ? (b.name + (b.serial ? ' · ' + b.serial : '')) : 'دراجة محذوفة';
const planLabel = r => PLANS[r.plan].label;
const openMaint = bid => DB.maint.some(m => m.bike_id === bid && m.status === 'open');
const initial = s => (String(s || '?').trim()[0] || '?');
const bikeAvatar = (b, lg) => (b && PHOTOS['b' + b.id]) ? '<img class="avatar bike' + (lg ? ' lg' : '') + '" src="' + PHOTOS['b' + b.id] + '" alt="">' : '<span class="avatar bike' + (lg ? ' lg' : '') + '">🏍</span>';
/* سعر الدراجة لكل نظام أجرة (أسعار كل دراجة مستقلة؛ 15 و30 دقيقة تُحسب من سعر الساعة إن تُركت فارغة) */
function priceFor(b, plan) {
  const rate = b.rate || DB.settings.default_rate;
  const day = b.rate_day || (b.month_price ? Math.round(b.month_price / 30) : 0);
  return plan === 'q15' ? (b.rate15 || Math.round(rate / 4)) : plan === 'q30' ? (b.rate30 || Math.round(rate / 2)) : plan === 'h60' ? rate :
    plan === 'day' ? day : plan === 'week' ? (b.rate_week || day * 7) : plan === 'month' ? (b.month_price || day * 30) : 0;
}
function planDesc(r) { return r.plan === 'flat' ? 'سعر مقطوع ' + fmt(r.price) + ' لمدة ' + r.qty + ' يوم' : PLANS[r.plan].label + ' · ' + fmt(r.price) + (r.qty ? ' × ' + r.qty : ''); }
const avatar = (c, lg) => (c && PHOTOS[c.id]) ? '<img class="avatar' + (lg ? ' lg' : '') + '" src="' + PHOTOS[c.id] + '" alt="">' : '<span class="avatar' + (lg ? ' lg' : '') + '">' + esc(initial(c && c.name)) + '</span>';

/* ====================== الصندوق (دفتر الحركات) ====================== */
const CASH = {
  adv: ['عربون / دفعة مقدمة', 1], rental_pay: ['دفعة إيجار', 1], debt: ['سداد دين', 1], refund: ['رد عربون', -1],
  expense: ['مصروف', -1], maint: ['صيانة', -1], bike_buy: ['شراء دراجة', -1], bike_sale: ['بيع دراجة', 1],
  repair_rev: ['إيراد إصلاح دراجة', 1], owner_in: ['إيداع من المالك', 1], owner_out: ['سحب المالك', -1],
};
function cashAdd(type, amount, ref, cat, note, at) {
  amount = Math.abs(+amount || 0); if (!amount) return;
  DB.cash.push({id: nid('cash'), at: at || Date.now(), type, amount: amount * CASH[type][1], ref: ref || 0, cat: cat || '', note: note || ''});
}
const cashBalance = () => (+DB.settings.opening_cash || 0) + sum(DB.cash, e => e.amount);

/* ====================== حساب الإيجار ======================
 * الوحدة (15/30/60 دقيقة) تُحسب كاملة إذا تجاوزت دقائق السماح. إن حُدّدت مدة متفق عليها:
 *  - تأخير = الوقت الفعلي بعد المدة المتفقة، ويُحسب بوحدات كاملة × السعر × (1 + نسبة التأخير).
 *  - إرجاع مبكر: الوقت الفعلي (الافتراضي) أو المدة المتفقة كاملة حسب الإعداد.
 * الاشتراك الشهري: سعر ثابت لكل شهر، والتأخير يُحسب بالأيام (سعر الشهر ÷ 30 لليوم).
 */
function ceilGrace(mins, unit, grace) {
  let f = Math.floor(mins / unit + 1e-9); const rem = mins - f * unit;
  if (rem > 1e-9 && rem > grace) f++;
  return f;
}
function calcRental(r, arr) {
  const S = DB.settings, grace = Math.max(0, +S.grace || 0), late = +S.late_pct || 0, to = Math.max(1, +S.round_to || 1);
  const elapsed = Math.max(0, (arr - r.start) / 60000);
  let base = 0, delayMin = 0, delayCost = 0, units = 0;
  if (r.plan === 'month') {
    if (r.qty > 0) {
      const months = r.qty; base = months * r.price; units = months;
      const pe = r.planned_end || addMonths(r.start, months), d = Math.max(0, (arr - pe) / 60000);
      if (d > grace) { delayMin = Math.floor(d); delayCost = Math.ceil(d / 1440 - 1e-9) * (r.price / 30) * (1 + late / 100); }
    } else { /* اشتراك مفتوح: أشهر كاملة (30 يوماً) + الأيام الزائدة بسعر الشهر÷30، والحد الأدنى شهر */
      let months = Math.floor(elapsed / 43200 + 1e-9); const rem = elapsed - months * 43200; let days = rem > grace ? Math.ceil(rem / 1440 - 1e-9) : 0;
      if (months === 0) { months = 1; days = 0; }
      base = months * r.price + days * (r.price / 30); units = months;
    }
  } else {
    const u = r.unit_min || 60, actual = Math.max(1, ceilGrace(elapsed, u, grace)), flat = r.plan === 'flat';
    const du = (r.plan === 'week' || flat) ? 1440 : u, dp = r.plan === 'week' ? r.price / 7 : flat ? r.price / Math.max(1, r.qty) : r.price;
    if (r.qty > 0) {
      const d = elapsed - r.qty * u;
      if (d > grace) { delayMin = Math.floor(d); delayCost = Math.ceil(d / du - 1e-9) * dp * (1 + late / 100); base = flat ? r.price : r.qty * r.price; units = r.qty; }
      else { units = S.early_mode === 'agreed' ? r.qty : Math.min(r.qty, actual); base = flat ? r.price : units * r.price; }
    } else { units = actual; base = flat ? r.price : actual * r.price; }
  }
  base = Math.round(base); delayCost = Math.round(delayCost);
  return {base, delayMin, delayCost, total: Math.round((base + delayCost) / to) * to, units, elapsed};
}
function plannedEnd(plan, start, qty) {
  if (plan === 'month') return qty > 0 ? addMonths(start, qty) : 0;
  return qty > 0 ? start + qty * PLANS[plan].unit * 60000 : 0;
}

/* ====================== الصور ====================== */
let PEND = {mode: 'keep', data: null};
function readPhoto(file) {
  return new Promise((res, rej) => {
    const img = new Image(), url = URL.createObjectURL(file);
    img.onload = () => {
      const M = 480; let w = img.naturalWidth, h = img.naturalHeight; const s = Math.min(1, M / Math.max(w, h));
      w = Math.max(1, Math.round(w * s)); h = Math.max(1, Math.round(h * s));
      const c = document.createElement('canvas'); c.width = w; c.height = h; c.getContext('2d').drawImage(img, 0, 0, w, h);
      URL.revokeObjectURL(url); res(c.toDataURL('image/jpeg', 0.72));
    };
    img.onerror = () => { URL.revokeObjectURL(url); rej(new Error('img')); };
    img.src = url;
  });
}
function applyPhoto(cid) {
  if (PEND.mode === 'set' && PEND.data) { PHOTOS[cid] = PEND.data; savePhotos(); }
  else if (PEND.mode === 'remove' && PHOTOS[cid]) { delete PHOTOS[cid]; savePhotos(); }
  PEND = {mode: 'keep', data: null};
}

/* ====================== العمليات ====================== */
function startRental(f) {
  const bike = bikeOf(+f.bike_id);
  if (!bike || bike.status !== 'available' || isRented(bike.id)) return fail('الدراجة غير متاحة للتأجير');
  const plan = PLANS[f.plan] ? f.plan : 'h60', price = numIn(f.price);
  if (price <= 0) return fail('أدخل سعر الإيجار');
  const start = f.start ? parseLocal(f.start) : Date.now();
  if (isNaN(start) || start > Date.now() + 60000) return fail('وقت البداية غير صحيح أو في المستقبل');
  let qty = Math.max(0, Math.round(numIn(f.qty))); if (plan === 'flat' && qty < 1) return fail('أدخل عدد الأيام للسعر المقطوع');
  let cid = +f.customer_id || 0;
  if (!cid) {
    const name = (f.c_name || '').trim(); if (!name) return fail('اختر عميلاً أو أدخل اسم عميل جديد');
    cid = nid('cust');
    DB.customers.push({id: cid, name, phone: (f.c_phone || '').trim(), address: (f.c_address || '').trim(), guarantor: (f.c_guarantor || '').trim(),
      guarantor_phone: (f.c_gphone || '').trim(), notes: '', created: Date.now()});
    applyPhoto(cid);
  }
  const cuX = custOf(cid);
  if (cuX && cuX.blocked) return fail('هذا العميل محظور' + (cuX.block_reason ? ': ' + cuX.block_reason : '') + '. يرفع المدير الحظر أولاً.');
  const rid = nid('rent'), deposit = numIn(f.deposit);
  DB.rentals.push({id: rid, bike_id: bike.id, customer_id: cid, plan, unit_min: PLANS[plan].unit, price, qty, start, planned_end: plannedEnd(plan, start, qty),
    arrival: null, delay_min: 0, delay_cost: 0, base: 0, deposit, deposit_note: (f.deposit_note || '').trim(), discount: 0, total: 0, paid: 0, refund: 0,
    status: 'active', notes: (f.notes || '').trim(), by: who()});
  if (deposit > 0) cashAdd('adv', deposit, rid, '', 'عربون إيجار #' + rid, start > Date.now() - 36e5 ? Date.now() : start);
  logAct('إيجار جديد', '#' + rid + ' — ' + bikeLabel(bike) + ' — ' + (custOf(cid) || {}).name + ' — ' + PLANS[plan].label + ' ' + fmt(price));
  save(); flash('ok', 'بدأ الإيجار — العداد يعمل الآن'); go('dashboard');
}

function finishRental(id, f) {
  const r = rentalOf(id);
  if (!r || r.status !== 'active') { flash('err', 'هذا الإيجار منتهٍ أو غير موجود'); return go('dashboard'); }
  const arr = f.arrival ? parseLocal(f.arrival) : Date.now();
  if (isNaN(arr) || arr > Date.now() + 60000) return fail('وقت الوصول غير صحيح أو في المستقبل');
  if (arr < r.start) return fail('وقت الوصول قبل وقت البداية');
  const c = calcRental(r, arr), disc = Math.min(Math.max(0, numIn(f.discount)), c.total), total = c.total - disc;
  const due = Math.max(0, total - Math.min(r.deposit, total)), raw = String(f.paid ?? '').trim();
  const paid = raw === '' ? due : Math.min(Math.max(0, numIn(raw)), due), refund = Math.max(0, r.deposit - total), endNote = (f.end_notes || '').trim();
  Object.assign(r, {arrival: arr, delay_min: c.delayMin, delay_cost: c.delayCost, base: c.base, discount: disc, total, paid, refund, status: 'finished',
                    notes: (r.notes || '') + (endNote ? ' | ' + endNote : '')});
  if (paid > 0) cashAdd('rental_pay', paid, r.id, '', 'إيجار #' + r.id);
  if (refund > 0) cashAdd('refund', refund, r.id, '', 'رد عربون إيجار #' + r.id);
  if (f.del_customer) {
    const other = DB.rentals.some(x => x.customer_id === r.customer_id && x.status === 'active' && x.id !== r.id);
    if (balance(r) > 0) flash('err', 'لم يُحذف العميل لأن عليه مبلغاً متبقياً');
    else if (other) flash('err', 'لم يُحذف العميل لأن عنده إيجاراً آخر جارياً');
    else { const cu = custOf(r.customer_id); if (cu) { TMP[r.id] = {name: cu.name, phone: cu.phone}; DB.customers = DB.customers.filter(x => x.id !== cu.id); delete PHOTOS[cu.id]; savePhotos(); flash('ok', 'تم حذف بيانات العميل'); } }
  }
  logAct('إنهاء إيجار', '#' + r.id + ' — الإجمالي ' + fmt(total) + ' — مدفوع ' + fmt(paid) + (balance(r) > 0 ? ' — متبقي ' + fmt(balance(r)) : ''));
  save(); go('receipt/' + r.id);
}

function cancelRental(id) {
  if (!needAdmin()) return;
  const r = rentalOf(id); if (!r || r.status !== 'active') return go('dashboard');
  r.status = 'cancelled'; r.arrival = Date.now();
  if (r.deposit > 0) cashAdd('refund', r.deposit, r.id, '', 'إلغاء إيجار #' + r.id + ' ورد العربون');
  logAct('إلغاء إيجار', '#' + r.id);
  save(); flash('ok', 'تم إلغاء الإيجار'); go('dashboard');
}

function payDebt(id, amount) {
  const r = rentalOf(id); if (!r || r.status !== 'finished') return go('dashboard');
  const amt = Math.min(numIn(amount), balance(r));
  if (amt > 0) { r.paid += amt; cashAdd('debt', amt, r.id, '', 'سداد إيجار #' + r.id); logAct('سداد دين', '#' + r.id + ' — ' + fmt(amt)); save(); flash('ok', 'تم تسجيل الدفعة'); }
  go('receipt/' + id);
}
function payCustomerDebt(cid, amount) {
  let left = numIn(amount); if (left <= 0) return fail('أدخل مبلغاً صحيحاً');
  const debts = DB.rentals.filter(r => r.customer_id === cid && balance(r) > 0).sort((a, b) => a.id - b.id);
  const total = sum(debts, balance); if (!total) return fail('لا يوجد دين على هذا العميل');
  left = Math.min(left, total); const paidTotal = left;
  for (const r of debts) { if (left <= 0) break; const p = Math.min(left, balance(r)); r.paid += p; cashAdd('debt', p, r.id, '', 'سداد إيجار #' + r.id); left -= p; }
  logAct('سداد دين عميل', (custOf(cid) || {}).name + ' — ' + fmt(paidTotal));
  save(); flash('ok', 'تم تسجيل دفعة ' + fmt(paidTotal) + ' ' + CUR); go('customer/' + cid);
}

function saveBike(f) {
  if (!needAdmin()) return;
  const name = (f.name || '').trim(), serial = (f.serial || '').trim();
  if (!name) return fail('أدخل اسم الدراجة');
  if (serial && DB.bikes.some(b => b.serial === serial && b.id !== +f.id)) return fail('الرقم التسلسلي مسجل مسبقاً');
  const v = {name, type_id: +f.type_id || 0, size: (f.size || '').trim(), serial, buy_price: numIn(f.buy_price), sell_price: numIn(f.sell_price), rate: numIn(f.rate), rate15: numIn(f.rate15), rate30: numIn(f.rate30), rate_day: numIn(f.rate_day), rate_week: numIn(f.rate_week), month_price: numIn(f.month_price), notes: (f.notes || '').trim()};
  const ty = DB.types.find(t => t.id === v.type_id);
  if (ty && !v.rate) v.rate = ty.rate;
  if (ty && !v.month_price) v.month_price = ty.month_price;
  if (ty && !v.rate15) v.rate15 = ty.rate15;
  if (ty && !v.rate30) v.rate30 = ty.rate30;
  if (ty && !v.rate_day) v.rate_day = ty.rate_day;
  if (ty && !v.rate_week) v.rate_week = ty.rate_week;
  let bid = +f.id;
  if (+f.id) {
    const b = bikeOf(+f.id); Object.assign(b, v);
    const e = DB.cash.find(x => x.type === 'bike_buy' && x.ref === b.id); if (e) e.amount = -Math.abs(v.buy_price);
    flash('ok', 'تم حفظ التعديل');
  } else {
    const id = nid('bike'), at = dateToTs(f.buy_date); bid = id;
    DB.bikes.push({id, ...v, status: 'available', buy_date: at, sold_at: 0, sold_price: 0, sold_to: ''});
    if (!f.existing && v.buy_price > 0) cashAdd('bike_buy', v.buy_price, id, '', 'شراء ' + name, at);
    flash('ok', f.existing ? 'تمت إضافة الدراجة' : 'تم تسجيل شراء الدراجة وخصم ثمنها من الصندوق');
  }
  applyPhoto('b' + bid);
  logAct(+f.id ? 'تعديل دراجة' : 'شراء/إضافة دراجة', name + (serial ? ' ' + serial : '') + (v.buy_price ? ' — ' + fmt(v.buy_price) : ''));
  save(); go('bikes');
}
function sellBike(id, f) {
  if (!needAdmin()) return;
  const b = bikeOf(id); if (!b || b.status === 'sold') return go('bikes');
  if (isRented(b.id) || openMaint(b.id)) return fail('لا يمكن بيع دراجة مؤجرة أو في الصيانة');
  const price = numIn(f.sold_price); if (price <= 0) return fail('أدخل سعر البيع');
  const at = dateToTs(f.sold_date);
  Object.assign(b, {status: 'sold', sold_price: price, sold_at: at, sold_to: (f.sold_to || '').trim()});
  cashAdd('bike_sale', price, b.id, '', 'بيع ' + b.name + (b.sold_to ? ' إلى ' + b.sold_to : ''), at);
  logAct('بيع دراجة', bikeLabel(b) + ' — ' + fmt(price) + (b.sold_to ? ' إلى ' + b.sold_to : ''));
  save(); flash('ok', 'تم بيع الدراجة وإضافة المبلغ للصندوق'); go('bikes');
}
function undoSale(id) {
  if (!needAdmin()) return;
  const b = bikeOf(id); if (!b || b.status !== 'sold') return;
  DB.cash = DB.cash.filter(e => !(e.type === 'bike_sale' && e.ref === b.id));
  Object.assign(b, {status: 'available', sold_price: 0, sold_at: 0, sold_to: ''}); logAct('إلغاء بيع دراجة', bikeLabel(b)); save(); flash('ok', 'تم إلغاء البيع'); render();
}
function deleteBike(id) {
  if (!needAdmin()) return;
  if (DB.rentals.some(r => r.bike_id === id) || DB.maint.some(m => m.bike_id === id)) { flash('err', 'لا يمكن حذف دراجة لها إيجارات أو صيانة'); return render(); }
  if (!confirm('حذف الدراجة؟ سيُحذف أيضاً قيد شراؤها من الصندوق.')) return;
  logAct('حذف دراجة', bikeLabel(bikeOf(id)));
  if (PHOTOS['b' + id]) { delete PHOTOS['b' + id]; savePhotos(); }
  DB.bikes = DB.bikes.filter(b => b.id !== id); DB.cash = DB.cash.filter(e => !(e.type === 'bike_buy' && e.ref === id));
  save(); flash('ok', 'تم حذف الدراجة'); render();
}

function saveMaint(f, el) {
  const bike = bikeOf(+f.bike_id); if (!bike || bike.status === 'sold' || isRented(bike.id)) return fail('اختر دراجة غير مؤجرة');
  const names = [...el.querySelectorAll('[name=part_name]')], costs = [...el.querySelectorAll('[name=part_cost]')];
  const parts = names.map((n, i) => ({name: n.value.trim(), cost: numIn(costs[i].value)})).filter(p => p.name || p.cost > 0);
  if (parts.some(p => !p.name)) return fail('اكتب اسم كل قطعة أو عملية');
  const labor = numIn(f.labor), total = sum(parts, p => p.cost) + labor;
  if (!parts.length && labor <= 0) return fail('أضف قطعة أو أجرة عمل واحدة على الأقل');
  const id = nid('maint'), at = dateToTs(f.date), inShop = !!f.in_shop;
  DB.maint.push({id, bike_id: bike.id, date: at, parts, labor, total, notes: (f.notes || '').trim(), owner: (f.owner || '').trim(), by: who(), status: inShop ? 'open' : 'done', done_at: inShop ? 0 : at});
  if (inShop && bike.status === 'available') bike.status = 'maintenance';
  cashAdd((f.owner || '').trim() ? 'repair_rev' : 'maint', total, id, '', ((f.owner || '').trim() ? 'إصلاح دراجة ' + (f.owner || '').trim() + ' — ' : 'صيانة ') + bike.name, at);
  logAct('صيانة', bike.name + ' — ' + parts.map(p => p.name).join('، ') + ' — ' + fmt(total));
  save(); flash('ok', inShop ? 'سُجّلت الصيانة والدراجة خارج الخدمة حتى تكتمل' : 'تم تسجيل الصيانة — هذه فاتورة الإصلاح'); go(inShop ? 'maint' : 'invoice/' + id);
}
function addPart(mid, f) {
  const m = DB.maint.find(x => x.id === mid); if (!m) return;
  const name = (f.name || '').trim(), cost = numIn(f.cost); if (!name || cost <= 0) return fail('أدخل اسم القطعة وتكلفتها');
  m.parts.push({name, cost}); m.total += cost; cashAdd(m.owner ? 'repair_rev' : 'maint', cost, mid, '', name); logAct('قطعة صيانة', name + ' — ' + fmt(cost)); save(); flash('ok', 'تمت إضافة القطعة'); render();
}
function completeMaint(mid) {
  const m = DB.maint.find(x => x.id === mid); if (!m || m.status !== 'open') return;
  m.status = 'done'; m.done_at = Date.now(); logAct('اكتمال صيانة', bikeLabel(bikeOf(m.bike_id)));
  const b = bikeOf(m.bike_id); if (b && b.status === 'maintenance' && !openMaint(b.id)) b.status = 'available';
  save(); flash('ok', 'اكتملت الصيانة وعادت الدراجة للخدمة — هذه فاتورة الإصلاح'); go('invoice/' + mid);
}
function deleteMaint(mid) {
  if (!needAdmin()) return;
  const m = DB.maint.find(x => x.id === mid); if (!m || !confirm('حذف سجل الصيانة؟ سيُحذف قيده من الصندوق أيضاً.')) return;
  DB.maint = DB.maint.filter(x => x.id !== mid); DB.cash = DB.cash.filter(e => !((e.type === 'maint' || e.type === 'repair_rev') && e.ref === mid));
  const b = bikeOf(m.bike_id); if (b && b.status === 'maintenance' && !openMaint(b.id)) b.status = 'available';
  logAct('حذف سجل صيانة', bikeLabel(bikeOf(m.bike_id)) + ' — ' + fmt(m.total));
  save(); flash('ok', 'تم حذف سجل الصيانة'); render();
}

function saveType(f) {
  if (!needAdmin()) return;
  const name = (f.name || '').trim(); if (!name) return fail('أدخل اسم النوع');
  if (DB.types.some(t => t.name === name && t.id !== +f.id)) return fail('اسم النوع مسجّل مسبقاً');
  const v = {name, rate: numIn(f.rate), rate15: numIn(f.rate15), rate30: numIn(f.rate30), rate_day: numIn(f.rate_day), rate_week: numIn(f.rate_week), month_price: numIn(f.month_price), notes: (f.notes || '').trim()};
  if (+f.id) {
    const t = DB.types.find(x => x.id === +f.id); let n = 0; Object.assign(t, v);
    if (f.apply) DB.bikes.filter(b => b.type_id === t.id).forEach(b => { b.rate = v.rate; b.rate15 = v.rate15; b.rate30 = v.rate30; b.rate_day = v.rate_day; b.rate_week = v.rate_week; b.month_price = v.month_price; n++; });
    logAct('تعديل نوع دراجات', name + (f.apply ? ' — طُبّق السعر على ' + n + ' دراجة' : '')); flash('ok', f.apply ? 'تم الحفظ وتطبيق السعر على ' + n + ' دراجة (الإيجارات الجارية لا تتأثر)' : 'تم حفظ النوع');
  } else { DB.types.push({id: nid('type'), ...v}); logAct('إضافة نوع دراجات', name); flash('ok', 'تمت إضافة النوع'); }
  save(); go('types');
}
function deleteType(id) {
  if (!needAdmin()) return;
  const t = DB.types.find(x => x.id === id); if (!t || !confirm('حذف النوع؟ ستبقى دراجاته بأسعارها الحالية بدون نوع.')) return;
  DB.bikes.forEach(b => { if (b.type_id === id) b.type_id = 0; }); DB.types = DB.types.filter(x => x.id !== id);
  logAct('حذف نوع دراجات', t.name); save(); flash('ok', 'تم حذف النوع'); render();
}
async function saveUser(f) {
  if (!needAdmin()) return;
  const name = (f.name || '').trim(), pin = String(f.pin || '').trim();
  if (!name) return fail('أدخل اسم المستخدم');
  if (pin.length < 4) return fail('الرقم السري 4 أرقام على الأقل');
  if (DB.users.some(u => u.name === name)) return fail('هذا الاسم مستخدم');
  const first = !hasUsers();
  const u = {id: nid('user'), name, role: (first || f.role === 'admin') ? 'admin' : 'staff', pin: '', legacy: false, active: true};
  u.pin = await hashPin(pin, u); DB.users.push(u);
