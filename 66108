.tabs a b{display:block;font-size:1.25rem;line-height:1.2}
.tabs a.on{color:var(--pri)}
.tabs a.plus b{background:var(--pri);color:var(--pri-ink);border-radius:50%;width:34px;height:34px;line-height:34px;margin:0 auto;font-size:1.5rem}
